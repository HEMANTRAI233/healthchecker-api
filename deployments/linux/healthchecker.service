[Unit]
Description=HealthChecker Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/healthchecker/current
ExecStart=/opt/healthchecker/current/HealthChecker
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/healthchecker/app.env

[Install]
WantedBy=multi-user.target
